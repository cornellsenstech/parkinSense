# Optional sync. Leave both unset and the app runs entirely on-device, which is
# the default and the deployed configuration.
#
# EXPO_PUBLIC_ is not a mistake: Expo inlines these at build time, so anything
# with that prefix ends up readable in the shipped bundle. The anon key is
# designed for exactly that — it identifies the project, it does not grant
# access. Every row is protected by the row level security policies in
# supabase/schema.sql, which are evaluated against the signed-in user, not
# against this key.
#
# The service_role key is the opposite: it bypasses row level security entirely.
# It must never appear in this file, in the client, or anywhere near the bundle.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
